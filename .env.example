# Copy to .env. Do not commit .env or the data directory.
COOLAPK_BIND_IP=0.0.0.0
COOLAPK_HOST_PORT=18966

# Set the complete public HTTPS origin after creating the Lucky rule.
COOLAPK_PUBLIC_ORIGIN=

# Optional initial application access password (at least 10 characters).
# Leaving this blank enables password setup in the first browser session.
# This is the application password, not a Coolapk Cookie.
COOLAPK_ACCESS_PASSWORD=
